@page "/"
@using BlazorChat.Dto.Requests
@using BlazorChat.Dto.Results
@using BlazorChat.Sdk
@inject ChatChannelService ChatChannelService

<PageTitle>Chat Client</PageTitle>

<h1>Hello, chatter!</h1>

<input @bind="ChannelName" placeholder="Channel name" />
<button @onclick="Post">Create</button>

@if (Channels != null)
{
    <ul>
        @foreach (var channel in Channels)
        {
            <li>@channel.Name</li>
        }
    </ul>
}
else
{
    <p>There are no channels yet. Come back later...</p>
}


@code
{
    private IList<ChatChannelResult>? Channels { get; set; }

    private string ChannelName { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await Refresh();

        await base.OnInitializedAsync();
    }

    private async Task Refresh()
    {
        Channels = await ChatChannelService.Find();
    }

    private async Task Post()
    {
        var request = new ChatChannelRequest { Name = ChannelName };

        await ChatChannelService.Create(request);

        ChannelName = "";

        await Refresh();
    }
}
